  "tooling": [
    {
      "area": "tensor centralities",
      "observation": "CEC / ZEC centrality require a uniform hypergraph, i.e. every group the same size. Complex data spans sizes 2 to 129, so these are unavailable without slicing the data by size first.",
      "impact": "medium"
    },
    {
      "area": "spectral clustering",
      "observation": "The library's spectral routine drops isolated nodes before clustering, so its output rows no longer align with the node list returned by the hypergraph object. Aligning them incorrectly produces a plausible but wrong score.",
      "impact": "high - silent wrong answer",
      "mitigation": "obtain the index-to-node map from the incidence matrix, and check for zero-degree nodes before interpreting any output"
    },
    {
      "area": "projections",
      "observation": "clique_projection returns a networkx graph; bipartite_projection returns a tuple. The asymmetry is easy to miss.",
      "impact": "low"
    },
    {
      "area": "group identity",
      "observation": "Constructing a hypergraph from an edge list silently merges groups with identical membership, since a hyperedge is a set. Distinct groups that happen to share a composition are lost.",
      "impact": "medium - affects counts"
    },
    {
      "area": "ecosystem",
      "observation": "No managed hypergraph store comparable to a production property graph. Persistence, access control and bulk import must be built.",
      "impact": "high for production use"
    }
  ],
  "tradeoffs_headline": "Hub nodes add 5222 nodes (+109% vs pairwise) but -18% edges; hyperedges store the same information in 5222 objects.",
  "traversal": [
    {
      "representation": "dissolved",
      "hops": 1,
      "intermediate": "none",
      "cypher_sketch": "(x)-[:INTERACTS]-(y)",
